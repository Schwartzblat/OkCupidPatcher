# Copy to .env and fill in to sign with your own keystore.
# With KEYSTORE_PATH unset, stitch 1.4.x signs with its own bundled debug key
# (bin/debug.pem + bin/debug.pk8, via bin/fastsigner). No external signer needed.
# Note: stitch reads these from the environment, it does not load .env itself --
# use `set -a; . ./.env; set +a` or your runner's dotenv support.
KEYSTORE_PATH=/absolute/path/to/keystore.jks
KEY_ALIAS=key0
KEYSTORE_PASSWORD=changeme
KEY_PASSWORD=changeme
